# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>

# Платне просування (вкладка Promote). Без STRIPE_SECRET_KEY заявки оплачуються вручну:
# адмін позначає їх оплаченими на вкладці Promotions.
STRIPE_SECRET_KEY=sk_test_...
# Developers → Webhooks → https://<домен>/api/promo/webhook, події checkout.session.completed
# і checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=whsec_...
# select secret from private.promo_config;  — той самий рядок, що в базі
PROMO_SECRET=

# Google Analytics 4. На продакшені Vercel ID вже вшитий у components/GoogleAnalytics.tsx; ця змінна його перекриває.
NEXT_PUBLIC_GA_ID=

# Сповіщення (lib/notify). Секрет для черги — той самий, що PROMO_SECRET (private.promo_config);
# окремий NOTIFY_SECRET потрібен, лише якщо PROMO_SECRET не задано.
NOTIFY_SECRET=
# Пошта через Resend: ключ і адреса відправника з підтвердженого домену ("Resoha <hello@домен>")
RESEND_API_KEY=
EMAIL_FROM=
# Telegram-бот для ріелторів (@BotFather). Вебхук: https://<домен>/api/telegram/webhook
# із secret_token = TELEGRAM_WEBHOOK_SECRET (setWebhook, див. README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT=
# Vercel Cron підписує щоденний виклик /api/cron/notify цим секретом
CRON_SECRET=
