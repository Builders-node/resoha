# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>

# Платне просування (вкладка Promote). Без STRIPE_SECRET_KEY заявки оплачуються вручну:
# адмін позначає їх оплаченими на вкладці Promotions.
STRIPE_SECRET_KEY=sk_test_...
# Developers → Webhooks → https://<домен>/api/promo/webhook, події checkout.session.completed
# і checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=whsec_...
# select secret from private.promo_config;  — той самий рядок, що в базі
PROMO_SECRET=

# Google Analytics 4 (Admin → Data streams → Measurement ID). Без неї GA не вантажиться.
NEXT_PUBLIC_GA_ID=
